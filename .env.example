# Offline demo requires no credentials.
# Add provider settings only when implementing a live model adapter.

# Proposed for T5 only; currently NOT read by the runtime.
# Offline starters need no .env file. Never put credentials in browser code.
CREW_MODE=offline-demo
# Provider/model selection is intentionally deferred until T5.
CREW_PROVIDER=
CREW_MODEL=
CREW_API_KEY=
